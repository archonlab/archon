{
  "desktop": {
    "browser_required_for_visual_frontend": true,
    "fallback": "system browser + Tk lifecycle window",
    "preferred": "Chromium-family browser with --app mode"
  },
  "distribution": {
    "contract": "Packaging/distribution_contract.json",
    "single_release_tree": true,
    "stage_builder": "Tools/archon_distribution_stage.py",
    "target_artifacts": {
      "linux": "ARCHON-Studio-1.0.0.AppImage",
      "macos": "ARCHON-Studio-1.0.0.dmg",
      "windows": "ARCHON-Studio-1.0.0.exe"
    }
  },
  "frontend": {
    "bundle": "archon-studio/dist",
    "node_required_at_runtime": false,
    "vite_required_at_runtime": false
  },
  "network": {
    "default_port": 8765,
    "internet_required": false,
    "listen": "127.0.0.1 only"
  },
  "platform_launchers": {
    "canonical_entrypoint": "Tools/archon_studio_desktop.py",
    "linux": "ARCHON_STUDIO.sh",
    "macos": "ARCHON_STUDIO.command",
    "shared_runtime_path": true,
    "windows": "ARCHON_STUDIO.bat"
  },
  "python": {
    "bundled_runtime_root": "Runtime/python",
    "child_interpreter_contract": "Tools/archon_runtime_python.py",
    "dependency_preflight": "exact selected interpreter before Universe Search",
    "environment_override": "ARCHON_RUNTIME_PYTHON",
    "propagated_executable": "ARCHON_PYTHON_EXECUTABLE",
    "selection_precedence": [
      "configured",
      "propagated",
      "packaged",
      "inherited",
      "documented_path_fallback"
    ],
    "venv_symlink_preserved": true,
    "minimum": "3.12",
    "stdlib_only_for_studio_bridge": true
  },
  "research_state": {
    "bundled": false,
    "generated_at_runtime": [
      "archon-studio/public/studio/",
      "Results/Studio/",
      "Config/Studio/"
    ],
    "missing_atlas_is_valid": true
  },
  "universe_search": {
    "canonical_entrypoint": "Universe_Search/universe_search_v34_closed_research_cycle.py",
    "shared_launch_contract": "Universe_Search/search_runtime_contract.py",
    "missing_runtime_policy": "FAIL_CLOSED",
    "simulation_fallback": false,
    "telemetry_schema": "archon_search_runtime_v1",
    "telemetry_pid_bound": true,
    "generation_artifact_verified": true
  },
  "schema": "archon_studio_runtime_requirements_v3",
  "source_tree_policy": {
    "corrupt_provenance": "FAIL_CLOSED",
    "modified_local_sources": "WARN_AND_CONTINUE",
    "sealed_match": "VERIFIED"
  },
  "studio_version": "STUDIO20.5",
  "world_portability": {
    "collection_extension": ".archon-worlds",
    "collection_format": "ARCHON_WORLD_COLLECTION",
    "collection_format_version": 1,
    "collection_import_atomic": true,
    "collection_import_inspection": true,
    "format": "ARCHON_WORLD",
    "format_version": 1,
    "identity_version": 1,
    "extension": ".archon-world",
    "network_required": false,
    "unsafe_deserialization": false,
    "canonical_store": "Atlas/Worlds"
  }
}
