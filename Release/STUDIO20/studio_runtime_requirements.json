{
  "schema": "archon_studio_runtime_requirements_v3",
  "studio_version": "STUDIO20",
  "network": {
    "listen": "127.0.0.1 only",
    "default_port": 8765,
    "internet_required": false
  },
  "python": {
    "minimum": "3.10",
    "stdlib_only_for_studio_bridge": true,
    "child_interpreter_contract": "Tools/archon_runtime_python.py",
    "environment_override": "ARCHON_RUNTIME_PYTHON",
    "bundled_runtime_root": "Runtime/python"
  },
  "desktop": {
    "preferred": "Chromium-family browser with --app mode",
    "fallback": "system browser + Tk lifecycle window",
    "browser_required_for_visual_frontend": true
  },
  "frontend": {
    "node_required_at_runtime": false,
    "vite_required_at_runtime": false,
    "bundle": "archon-studio/dist"
  },
  "research_state": {
    "bundled": false,
    "generated_at_runtime": [
      "archon-studio/public/studio/",
      "Results/Studio/",
      "Config/Studio/"
    ],
    "missing_atlas_is_valid": true
  },
  "platform_launchers": {
    "linux": "ARCHON_STUDIO.sh",
    "windows": "ARCHON_STUDIO.bat",
    "macos": "ARCHON_STUDIO.command",
    "canonical_entrypoint": "Tools/archon_studio_desktop.py",
    "shared_runtime_path": true
  },
  "distribution": {
    "contract": "Packaging/distribution_contract.json",
    "stage_builder": "Tools/archon_distribution_stage.py",
    "single_release_tree": true,
    "target_artifacts": {
      "windows": "ARCHON-Studio-1.0.0.exe",
      "macos": "ARCHON-Studio-1.0.0.dmg",
      "linux": "ARCHON-Studio-1.0.0.AppImage"
    }
  }
}
